# Copy to .env and fill in the values. Do not commit .env.

# JWT signing secret for mock auth tokens (same value is used by mint_tokens.py)
JWT_SECRET=please-change-me-to-a-long-random-string

# Only for networks that intercept TLS with a corporate CA (model download fails otherwise)
# USE_SYSTEM_TRUST_STORE=true


# =============================================================================
# LLM PROVIDER — choose with LLM_PROVIDER = ollama | groq | openai
# Default is Ollama: fully local, no API key.
# =============================================================================
LLM_PROVIDER=ollama
# LLM_TEMPERATURE=0.0

# Ollama (default) — requires `ollama pull qwen2.5`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# Groq — free tier, no credit card, very fast streaming (https://console.groq.com)
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — paid, optional
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini


# =============================================================================
# EMBEDDINGS — free local model (downloads ~130MB once, runs on CPU)
# =============================================================================
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384


# =============================================================================
# VECTOR DB — Qdrant
# Leave QDRANT_URL unset to run Qdrant embedded on local disk (QDRANT_PATH).
# Embedded mode is single-process: run ingestion BEFORE starting the server.
# For a real server:  docker run -p 6333:6333 qdrant/qdrant   (or docker compose up -d)
# =============================================================================
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=policies

# Retrieval tuning
# RETRIEVAL_TOP_K=4
# RETRIEVAL_MIN_SCORE=0.65
